<?php
declare(strict_types=1);

/**
 * LiteControl - phpMyAdmin Single Sign-On (signon) Handler
 *
 * Validates a short-lived, single-use SSO token generated by the
 * authenticated LiteControl panel before starting the phpMyAdmin session.
 */

$token = $_GET['token'] ?? '';

if (!is_string($token) || !preg_match('/^[a-f0-9]{64}$/', $token)) {
    header('Location: /');
    exit;
}

$tokenFile = __DIR__ . '/tmp/sso_' . $token;

if (!is_file($tokenFile)) {
    header('Location: /');
    exit;
}

$createdAt = (int) filemtime($tokenFile);
@unlink($tokenFile);

if ((time() - $createdAt) > 30) {
    header('Location: /');
    exit;
}

session_name('SignonSession');
session_start();

$_SESSION['PMA_single_signon_user'] = '__PMA_SIGNON_USER__';
$_SESSION['PMA_single_signon_password'] = '__PMA_SIGNON_PASSWORD__';
$_SESSION['PMA_single_signon_host'] = 'localhost';

session_write_close();

header('Location: /phpmyadmin/');
exit;

