[Unit]
Description=LiteControl Out-of-Band Panel Web Server (Nginx)
After=network.target litecontrol-php.service
Requires=litecontrol-php.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/litecontrol/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/litecontrol/nginx/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -c /etc/litecontrol/nginx/nginx.conf -s reload
ExecStop=/bin/kill -s QUIT $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

