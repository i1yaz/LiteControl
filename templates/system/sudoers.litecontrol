# LiteControl privilege separation rule
# Allows the unprivileged 'litecontrol' panel user to invoke only the root-owned lc-cli engine and PHP CLI switcher
Defaults:litecontrol !requiretty
litecontrol ALL=(root) NOPASSWD: /usr/local/litecontrol/bin/lc-cli *
litecontrol ALL=(root) NOPASSWD: /usr/local/lib/lc-panel/set-user-php-cli.sh *

