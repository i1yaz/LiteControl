[Unit]
Description=LiteControl Isolated Panel PHP-FPM Service
After=network.target mariadb.service redis-server.service

[Service]
Type=simple
ExecStart=__PHP_FPM_BIN__ --nodaemonize --fpm-config /etc/litecontrol/php-fpm/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

