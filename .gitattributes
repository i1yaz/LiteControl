# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF line endings for all Linux scripts, shell entrypoints, and server configs
*.sh text eol=lf
*.tpl text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sql text eol=lf
bin/lc-cli text eol=lf
*.phar binary -text -diff -merge eol=unset
templates/** text eol=lf
scripts/** text eol=lf

