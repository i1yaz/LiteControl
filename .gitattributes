# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF line endings for all Linux scripts, binaries, and server configs
*.sh text eol=lf
*.tpl text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sql text eol=lf
bin/* text eol=lf
*.phar binary
templates/** text eol=lf
scripts/** text eol=lf

